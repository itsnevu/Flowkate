# Copy this file to .env.local and fill in the values you need.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Only variables prefixed with VITE_ are read, and
# they are loaded from this directory (the repo root) by chrome-extension/vite.config.mts.
#
# Nothing here is required to build or run Flowkite. Your LLM API keys are NOT
# configured here — you enter those in the extension's own Settings page, and
# they are stored in Chrome local storage on your machine.

# Optional. PostHog project key for anonymous usage analytics.
# Leave it empty and analytics stays off: the code disables itself when the key
# is missing. Users can also opt out in Settings regardless of this value.
VITE_POSTHOG_API_KEY=
